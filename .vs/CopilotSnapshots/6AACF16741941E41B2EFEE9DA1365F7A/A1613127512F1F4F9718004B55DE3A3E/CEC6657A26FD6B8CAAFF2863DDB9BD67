using BankApiApp.Data;
using BankApiApp.Models;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.SignalR;
using Microsoft.EntityFrameworkCore;
using System.Security.Claims;

namespace BankApiApp.Hubs;

[Authorize]   // yalnız login olmuş istifadəçilər qoşula bilər
public class ChatHub : Hub
{
    private readonly AppDbContext _context;

    public ChatHub(AppDbContext context)
    {
        _context = context;
    }

    // istifadəçinin id və adını token-dən götür
    private string UserId => Context.User!.FindFirstValue(ClaimTypes.NameIdentifier)!;
    private string UserName => Context.User!.FindFirstValue(ClaimTypes.Name) ?? "İstifadəçi";
    private bool IsAdmin => Context.User!.IsInRole("Admin");

    // qoşulanda: adminləri "admins" qrupuna əlavə et
    public override async Task OnConnectedAsync()
    {
        if (IsAdmin)
            await Groups.AddToGroupAsync(Context.ConnectionId, "admins");

        await base.OnConnectedAsync();
    }

    // İSTİFADƏÇİ → ADMIN mesaj göndərir
    public async Task SendToAdmin(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return;

        var message = new ChatMessage
        {
            SenderId = UserId,
            SenderName = UserName,
            ReceiverId = "admin",       // adminlərə ümumi
            Content = content,
            IsFromAdmin = false,
            IsRead = false,
            SentAt = DateTime.UtcNow
        };

        _context.ChatMessages.Add(message);
        await _context.SaveChangesAsync();

        // bütün adminlərə real-time itələ
        await Clients.Group("admins").SendAsync("ReceiveMessage", new
        {
            id = message.Id,
            senderId = message.SenderId,
            senderName = message.SenderName,
            content = message.Content,
            isFromAdmin = false,
            sentAt = message.SentAt
        });

        // göndərənin özünə də təsdiq (öz mesajını görsün)
        await Clients.Caller.SendAsync("MessageSent", new
        {
            id = message.Id,
            content = message.Content,
            sentAt = message.SentAt
        });
    }

    // ADMIN → İSTİFADƏÇİ cavab göndərir
    public async Task SendToUser(string userId, string content)
    {
        if (!IsAdmin || string.IsNullOrWhiteSpace(content))
            return;

        var message = new ChatMessage
        {
            SenderId = UserId,          // admin id
            SenderName = UserName,      // admin adı
            ReceiverId = userId,        // konkret istifadəçi
            Content = content,
            IsFromAdmin = true,
            IsRead = false,
            SentAt = DateTime.UtcNow
        };

        _context.ChatMessages.Add(message);
        await _context.SaveChangesAsync();

        // konkret istifadəçiyə real-time itələ (userId ilə)
        await Clients.User(userId).SendAsync("ReceiveMessage", new
        {
            id = message.Id,
            senderId = message.SenderId,
            senderName = message.SenderName,
            content = message.Content,
            isFromAdmin = true,
            sentAt = message.SentAt
        });

        // admin özü də görsün
        await Clients.Caller.SendAsync("MessageSent", new
        {
            id = message.Id,
            content = message.Content,
            sentAt = message.SentAt
        });
    }
}